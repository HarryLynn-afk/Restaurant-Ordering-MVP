rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isValidCustomerOrderUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let slipChanged = changed.hasAny(['paymentSlipPath']);
      let tokenChanged = changed.hasAny(['fcmToken']);

      return isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && changed.hasOnly(['paymentSlipPath', 'fcmToken'])
        && (!slipChanged
          || (
            request.resource.data.paymentSlipPath is string
            && request.resource.data.paymentSlipPath.matches('^slips/[^/]+/[^/]+$')
            && request.resource.data.paymentSlipPath.size() <= 200
          ))
        && (!tokenChanged
          || (
            request.resource.data.fcmToken is string
            && request.resource.data.fcmToken.size() > 0
            && request.resource.data.fcmToken.size() <= 4096
          ));
    }

    // Allows slip upload even when the anonymous session has changed since the
    // order was placed (e.g. browser cleared, in-app browser reset).
    // The uid-in-path check ties the Storage write to the Firestore write:
    // both must use the same current session uid, so only the uploader can
    // link their own storage file to the order.
    function isValidSlipUpload() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let newPath = request.resource.data.paymentSlipPath;
      return isSignedIn()
        && changed.hasOnly(['paymentSlipPath'])
        && resource.data.get('paymentSlipPath', null) == null
        && newPath is string
        && newPath.matches('^slips/' + request.auth.uid + '/[^/]+$')
        && newPath.size() <= 200;
    }

    match /menuItems/{itemId} {
      allow get, list: if true;
      allow create, update, delete: if isStaff();
    }

    function isValidStaffUpdate() {
      let newStatus = request.resource.data.status;
      let currentStatus = resource.data.status;
      let hasSlip = resource.data.get('paymentSlipPath', null) != null;
      return isStaff() && (
        newStatus != 'cancelled'
        || currentStatus == 'new'
        || (currentStatus == 'unpaid' && !hasSlip)
      );
    }

    match /orders/{orderId} {
      allow get: if isStaff() || isSignedIn();
      allow list: if isStaff();
      // Orders are created only by the callable after its rate-limit check.
      allow create: if false;
      allow update: if isValidStaffUpdate() || isValidCustomerOrderUpdate() || isValidSlipUpload();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isStaff();
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
