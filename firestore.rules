rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn()
        && request.auth.token.get('staff', false) == true;
    }

    function isValidCustomerOrderUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let slipChanged = changed.hasAny(['paymentSlipPath']);
      let tokenChanged = changed.hasAny(['fcmToken']);

      return isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && changed.hasOnly(['paymentSlipPath', 'fcmToken'])
        && (!slipChanged
          || (
            resource.data.status == 'unpaid'
            && resource.data.get('paymentSlipPath', null) == null
            && request.resource.data.paymentSlipPath is string
            && request.resource.data.paymentSlipPath.matches('^slips/' + request.auth.uid + '/[^/]+$')
            && request.resource.data.paymentSlipPath.size() <= 200
          ))
        && (!tokenChanged
          || (
            request.resource.data.fcmToken is string
            && request.resource.data.fcmToken.size() > 0
            && request.resource.data.fcmToken.size() <= 4096
          ));
    }

    match /menuItems/{itemId} {
      allow get, list: if true;
      allow create, update, delete: if isStaff();
    }

    function isValidStaffUpdate() {
      let newStatus = request.resource.data.status;
      let currentStatus = resource.data.status;
      let hasSlip = resource.data.get('paymentSlipPath', null) != null;
      return isStaff() && (
        newStatus != 'cancelled'
        || currentStatus == 'new'
        || (currentStatus == 'unpaid' && !hasSlip)
      );
    }

    match /orders/{orderId} {
      allow get: if isStaff() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isStaff();
      // Orders are created only by the callable after its rate-limit check.
      allow create: if false;
      allow update: if isValidStaffUpdate() || isValidCustomerOrderUpdate();
      allow delete: if false;
    }

    match /settings/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isStaff();
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }
  }
}
